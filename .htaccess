# =====================================================================
# Configuração Otimizada para Hostinger (Apache / LiteSpeed)
# Psicóloga Natalie Thedim · CRP 05/45482
# =====================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirecionamento automático para HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> domínio sem www (mesmo host do canonical)
  RewriteCond %{HTTP_HOST} ^www\.nataliethedim\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://nataliethedim.com.br/$1 [L,R=301]

  # /pagina.html -> /pagina (um único endereço por página; evita conteúdo duplicado)
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # Suporte a URLs limpas sem extensão .html (ex: /biblioteca -> /biblioteca.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# Cache inteligente de ativos estáticos (Performance Core Web Vitals)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Cabeçalhos de Segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compressão (Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Arquivos internos que nunca devem ser servidos
<FilesMatch "\.(sql|md|mjs|zip|tar|gz|env|log|bak|sh|py)$|^(package(-lock)?\.json|server\.js|vercel\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(turso|hostinger|node_modules)/ - [F,L]
</IfModule>

# Admin e API fora do índice do Google
<IfModule mod_headers.c>
  <FilesMatch "^admin\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
